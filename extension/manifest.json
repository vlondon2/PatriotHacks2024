{
    "manifest_version": 3,
    "name": "Byte-Sized Terms",
    "version": "1.0",
    "description": "peepee poopoo",
    "action": {
      "default_popup": "popup.html",
      "default_icon":  "pthackslogo.png"
      
    },
    "icons": {
    "128": "pthackslogo.png"
  },
  "background": {
    "service_worker": "background.js"
  },
    "permissions": [
      "activeTab",
      "tabs"
    ],
    "content_scripts": [
      {
        "matches": ["<all_urls>"], 
        "js": ["content.js"]
      }
    ],
    "host_permissions": [
      "http://*/*",
      "https://*/*"
  ]
  }
  